package com.cnb.eds.editor.service;

import java.io.BufferedReader;
import java.io.InputStream;
import java.io.InputStreamReader;
import java.io.PrintWriter;

import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

import com.ibm.ecm.extension.PluginService;
import com.ibm.ecm.extension.PluginServiceCallbacks;
import com.ibm.json.java.JSONObject;

/**
 * Service to expose lookupConfig.json to the client-side JavaScript
 * Loads JSON directly from classpath
 */
public class GetLookupConfigService extends PluginService {

    @Override
    public String getId() {
        return "GetLookupConfigService";
    }

    @Override
    public void execute(PluginServiceCallbacks callbacks, HttpServletRequest request, HttpServletResponse response) throws Exception {
        System.out.println("[GetLookupConfigService] Request received");
        
        try {
            // Load JSON file directly from classpath
            System.out.println("[GetLookupConfigService] Loading lookupConfig.json from classpath...");
            
            InputStream is = getClass().getResourceAsStream("/com/cnb/eds/editor/config/lookupConfig.json");
            
            if (is == null) {
                System.err.println("[GetLookupConfigService] ✗ lookupConfig.json NOT FOUND in classpath!");
                System.err.println("[GetLookupConfigService] Tried path: /com/cnb/eds/editor/config/lookupConfig.json");
                
                response.setStatus(HttpServletResponse.SC_NOT_FOUND);
                
                JSONObject errorResponse = new JSONObject();
                errorResponse.put("error", "lookupConfig.json not found in JAR");
                errorResponse.put("documentClasses", new JSONObject());
                
                response.setContentType("application/json");
                PrintWriter writer = response.getWriter();
                writer.write(errorResponse.serialize());
                writer.flush();
                return;
            }
            
            System.out.println("[GetLookupConfigService] ✓ Found lookupConfig.json");
            
            // Read the JSON file
            BufferedReader reader = new BufferedReader(new InputStreamReader(is, "UTF-8"));
            StringBuilder jsonString = new StringBuilder();
            String line;
            
            while ((line = reader.readLine()) != null) {
                jsonString.append(line);
            }
            reader.close();
            is.close();
            
            System.out.println("[GetLookupConfigService] ✓ Read " + jsonString.length() + " characters");
            
            // Parse JSON
            JSONObject fullConfig = JSONObject.parse(jsonString.toString());
            
            // Extract only documentClasses (don't expose datasource credentials)
            JSONObject clientConfig = new JSONObject();
            JSONObject docClasses = (JSONObject) fullConfig.get("documentClasses");
            
            if (docClasses != null) {
                clientConfig.put("documentClasses", docClasses);
                System.out.println("[GetLookupConfigService] ✓ Found " + docClasses.size() + " document class(es):");
                
                for (Object key : docClasses.keySet()) {
                    System.out.println("[GetLookupConfigService]   - " + key);
                }
            } else {
                clientConfig.put("documentClasses", new JSONObject());
                System.out.println("[GetLookupConfigService] ⚠ No documentClasses found in config");
            }
            
            // Return the configuration as JSON
            response.setContentType("application/json");
            response.setCharacterEncoding("UTF-8");
            response.setStatus(HttpServletResponse.SC_OK);
            
            PrintWriter writer = response.getWriter();
            writer.write(clientConfig.serialize());
            writer.flush();
            
            System.out.println("[GetLookupConfigService] ✓ Configuration sent successfully");
            
        } catch (Exception e) {
            System.err.println("[GetLookupConfigService] ✗ Error: " + e.getMessage());
            e.printStackTrace();
            
            response.setStatus(HttpServletResponse.SC_INTERNAL_SERVER_ERROR);
            
            JSONObject errorResponse = new JSONObject();
            errorResponse.put("error", e.getMessage());
            errorResponse.put("documentClasses", new JSONObject());
            
            response.setContentType("application/json");
            PrintWriter writer = response.getWriter();
            writer.write(errorResponse.serialize());
            writer.flush();
        }
    }
}




